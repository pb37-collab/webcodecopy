# Chunky Academy free-sample landers (/chunky/free-sample-v1, /chunky/free-sample-v2)
# Copy to .env.local for local testing, or add each one in Vercel → Project → Settings →
# Environment Variables. Every value is optional: while the domain or a variant ID is
# missing, the pages run in preview mode and show the cart link instead of redirecting.
# Full guide: docs/chunky/INTEGRATION.md

# --- Shopify cart --------------------------------------------------------------
# Domain that serves the Shopify cart. Use the primary domain if the storefront is
# Shopify's Online Store, or the *.myshopify.com domain if the storefront is custom.
NEXT_PUBLIC_SHOPIFY_DOMAIN=

# Numeric variant IDs of the two free-sample products.
NEXT_PUBLIC_RUNTZ_VARIANT_ID=
NEXT_PUBLIC_SNOWCAPS_VARIANT_ID=

# "cart" (default) lands on the cart page; "checkout" skips straight to checkout.
NEXT_PUBLIC_SAMPLE_DESTINATION=cart

# Optional discount code applied by the cart link (e.g. 100% off, once per customer).
NEXT_PUBLIC_SAMPLE_DISCOUNT_CODE=

# Optional: replaces the Shopify cart link entirely. Tokens:
# {variantId} {sample} {email} {firstName} {discount} {source}
NEXT_PUBLIC_SAMPLE_CART_URL_TEMPLATE=

# Pre-fill the checkout email with the one they typed (default true).
NEXT_PUBLIC_PREFILL_CHECKOUT_EMAIL=true

# --- Lead capture --------------------------------------------------------------
# Klaviyo public API key (the 6-character Site ID; safe in the browser) and list ID.
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
NEXT_PUBLIC_KLAVIYO_LIST_ID=
# Metric fired on every claim. Build the confirmation/follow-up flow off this.
NEXT_PUBLIC_KLAVIYO_EVENT_NAME=Claimed Free Sample

# Optional webhook (Zapier, Make, Shopify Flow, your own API) that gets every lead as JSON.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# --- Copy ----------------------------------------------------------------------
# Offer terms line shown on both pages.
NEXT_PUBLIC_SAMPLE_OFFER_NOTE=Just cover shipping.
