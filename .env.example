# Chunky Academy free-sample landers (/chunky/free-sample-v1, /chunky/free-sample-v2)
# Copy to .env.local for local testing, or add each one in Vercel → Project → Settings →
# Environment Variables. Every value is optional: the defaults below already match
# chunkyacademy.com's current free-sample setup. Full guide: docs/chunky/INTEGRATION.md

# --- How the cart is built -------------------------------------------------------
# "chunky-api" (default): the same calls chunkyacademy.com/free-sample makes today:
#   POST /api/klaviyo/subscribe, then POST /api/cart/create-with-product → checkoutUrl.
#   Goes live automatically when the page is served from chunkyacademy.com.
# "permalink": a Shopify cart permalink on the myshopify domain; works from any host.
NEXT_PUBLIC_SAMPLE_CART_MODE=chunky-api

# chunky-api mode only: leave empty when the pages live on chunkyacademy.com. Set it to
# https://www.chunkyacademy.com to call the API from another domain (that site must then
# allow cross-origin requests from this one).
NEXT_PUBLIC_CHUNKY_API_BASE=

# Shopify variant IDs. Defaults are the live retail variants (Jolly Rancher Runtz 7g,
# Cotton Candy Toast Snow Cap 3.5g). Use dedicated $0 sample variants, or make sure the
# discount code below covers these, before sending traffic.
NEXT_PUBLIC_RUNTZ_VARIANT_ID=42552332812362
NEXT_PUBLIC_SNOWCAPS_VARIANT_ID=43660890832970

# Discount applied to the cart ("free-sample" is the code the current page uses).
NEXT_PUBLIC_SAMPLE_DISCOUNT_CODE=free-sample

# Klaviyo list claimers join (V2Si39 is the current free-sample list).
NEXT_PUBLIC_KLAVIYO_LIST_ID=V2Si39

# --- permalink mode only ---------------------------------------------------------
NEXT_PUBLIC_SHOPIFY_DOMAIN=chunkyacademy.myshopify.com
# "checkout" (default) or "cart".
NEXT_PUBLIC_SAMPLE_DESTINATION=checkout
NEXT_PUBLIC_PREFILL_CHECKOUT_EMAIL=true
# Optional full override. Tokens: {variantId} {sample} {email} {firstName} {discount} {source}
NEXT_PUBLIC_SAMPLE_CART_URL_TEMPLATE=

# --- Optional extras ---------------------------------------------------------------
# Klaviyo public key (Site ID): adds a "Claimed Free Sample" event with the sample chosen
# (and, in permalink mode, subscribes them to the list above).
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
NEXT_PUBLIC_KLAVIYO_EVENT_NAME=Claimed Free Sample
# Webhook (Zapier, Make, Google Sheets, your own API) that gets every lead as JSON.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# --- Copy --------------------------------------------------------------------------
NEXT_PUBLIC_SAMPLE_OFFER_NOTE=The flower is free. You just pay shipping.

# --- Limited run ---------------------------------------------------------------------
# Run size (the "300 left" meter, per-strain bars and copy follow these).
NEXT_PUBLIC_RUNTZ_STOCK_TOTAL=150
NEXT_PUBLIC_SNOWCAPS_STOCK_TOTAL=150
# Fallback "left" counts, shown until live inventory answers (or always, with no endpoint).
NEXT_PUBLIC_RUNTZ_STOCK_LEFT=150
NEXT_PUBLIC_SNOWCAPS_STOCK_LEFT=150
# Live counts: a URL returning {"runtz": n, "snowcaps": n}. Empty = the site's own
# /api/free-sample/inventory when live on chunkyacademy.com; "off" disables.
NEXT_PUBLIC_SAMPLE_INVENTORY_URL=
